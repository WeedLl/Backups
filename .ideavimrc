"" IdeaVim: базовые настройки.
"" vim-plug, NERDTree, :language, :langmenu, :mousehide и GUI-опции
"" в IdeaVim не используются — плагины и раскладку даёт IDE.

set ruler
set number
set autoindent

" Python: 4 пробела
set tabstop=4
set shiftwidth=4
set smarttab
set expandtab
set softtabstop=4

" Перенос строк и backspace
set wrap
set linebreak
set backspace=indent,eol,start

" Поиск
set hlsearch
set incsearch
